{
  "name": "waxcode-web-ui",
  "version": "0.0.0",
  "description": "The browser UI for a Waxcode box. React + TypeScript.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhallrp/waxcode-main.git"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && node scripts/check-tokens.mjs && vitest run",
    "tokens": "node ../tools/generate-design-tokens.mjs",
    "deploy": "sh scripts/deploy.sh",
    "test": "vitest run",
    "check:bundle": "./scripts/check-bundle-fresh.sh"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^27.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
